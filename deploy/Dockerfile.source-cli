# OpenShell Console — image with a locally built CLI.
#
# Use this when the gateway runs a development build and no published release is
# wire-compatible with it. Build the CLI for the container architecture first,
# then pass the directory holding it as a named build context:
#
#   # in the OpenShell checkout
#   cargo build --release --package openshell-cli --target x86_64-unknown-linux-musl
#   mkdir -p /tmp/cli
#   cp target/x86_64-unknown-linux-musl/release/openshell /tmp/cli/openshell
#
#   # in this repo
#   docker build -f deploy/Dockerfile.source-cli \
#     --build-context cli=/tmp/cli -t openshell-console:dev .
#
# Only the CLI source differs from the top-level Dockerfile; the rest of the
# stages are identical on purpose so the two images cannot drift.

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json vite.config.ts index.html ./
COPY src ./src
COPY server ./server
RUN npm run build

FROM node:22-alpine
RUN addgroup -S console && adduser -S console -G console
WORKDIR /app
ENV NODE_ENV=production \
    OPENSHELL_UI_HOST=0.0.0.0 \
    OPENSHELL_UI_PORT=8787 \
    XDG_CONFIG_HOME=/config \
    HOME=/home/console \
    OPENSHELL_BIN=/usr/local/bin/openshell
RUN mkdir -p /config && chown console:console /config
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/dist ./dist
COPY server ./server
# The named context must contain `openshell` (a static linux binary).
COPY --from=cli /openshell /usr/local/bin/openshell
COPY deploy/entrypoint.sh /usr/local/bin/openshell-console-entrypoint
RUN chmod 0755 /usr/local/bin/openshell /usr/local/bin/openshell-console-entrypoint
USER console
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "process.env.NODE_TLS_REJECT_UNAUTHORIZED='0';const p=process.env.OPENSHELL_UI_PORT||8787;fetch('http://127.0.0.1:'+p+'/api/auth/config').then(r=>process.exit(r.ok?0:1)).catch(()=>fetch('https://127.0.0.1:'+p+'/api/auth/config').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1)))"
ENTRYPOINT ["/usr/local/bin/openshell-console-entrypoint"]
CMD ["node", "server/index.ts"]
