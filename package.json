{
  "name": "openshell-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "node server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "start": "node server/index.ts",
    "dev:server:oidc": "OPENSHELL_UI_AUTH=oidc OPENSHELL_UI_OIDC_ISSUERS=http://localhost:8080/realms/tenant-a,http://localhost:8080/realms/tenant-b node server/index.ts",
    "dev:oidc": "concurrently -n server,web -c magenta,cyan \"npm:dev:server:oidc\" \"npm:dev:web\"",
    "dev:server:entra": "OPENSHELL_UI_AUTH=oidc node server/index.ts",
    "dev:entra": "concurrently -n server,web -c magenta,cyan \"npm:dev:server:entra\" \"npm:dev:web\"",
    "dev:server:all": "OPENSHELL_UI_AUTH=oidc OPENSHELL_UI_OIDC_ISSUERS=\"Lab realm A=http://localhost:8080/realms/tenant-a,Lab realm B=http://localhost:8080/realms/tenant-b\" node server/index.ts",
    "dev:all": "concurrently -n server,web -c magenta,cyan \"npm:dev:server:all\" \"npm:dev:web\"",
    "demo:all": "npm run dev:all",
    "test:sweep": "node scripts/sweep.mjs",
    "demo": "npm run dev",
    "demo:oidc": "npm run dev:oidc",
    "demo:entra": "npm run dev:entra"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "ws": "^8.22.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "typescript": "5.9",
    "vite": "^8.3.7"
  },
  "description": "Local web console for the OpenShell sandbox runtime: multi-gateway management, sandbox lifecycle, live PTY, network-rule approvals, dynamic policy editing, provider profiles, and optional OIDC sign-in.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laik/openshell-ui.git"
  },
  "homepage": "https://github.com/laik/openshell-ui#readme",
  "bugs": {
    "url": "https://github.com/laik/openshell-ui/issues"
  },
  "keywords": [
    "openshell",
    "sandbox",
    "console",
    "gateway",
    "oidc",
    "keycloak",
    "xterm",
    "mui",
    "react"
  ],
  "engines": {
    "node": ">=22.6"
  }
}